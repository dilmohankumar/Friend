# ---- Core ----
PORT=3000
PUBLIC_BASE_URL=http://10.0.2.2:3000        # URL the phone uses to reach the API (emulator: 10.0.2.2)
DATABASE_URL=postgresql://situationship:situationship@localhost:5432/situationship
REDIS_URL=redis://localhost:6379
# NODE_ENV=production forces LIVE mode as well

# ---- Secrets (required in production; generate with: openssl rand -hex 32) ----
JWT_SECRET=
APP_SECRET=
KYC_PROVIDER_SECRET=

# ---- Demo/live mode is automatic ----
# No MSG91 keys below  -> DEMO mode: OTP shown in the app, mock identity check, 10 demo profiles.
# MSG91 keys present   -> LIVE mode: all of that turns off by itself (S3 + secrets then become mandatory).
# Do NOT set DEV_SHOW_OTP / MOCK_KYC / SEED_DEMO here; the server refuses to start live if any is true.

# ---- Identity verification: DigiLocker (Govt. of India, "Meri Pehchaan" requester API) ----
# Get client id/secret by registering as a requester on API Setu / the DigiLocker partner portal, and register the
# redirect URI the server prints at startup:  <PUBLIC_BASE_URL>/api/kyc/digilocker/callback
KYC_PROVIDER=digilocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_BASE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2
# DIGILOCKER_REQUIRE_EAADHAAR=true   # only trust the DOB of Aadhaar-backed DigiLocker accounts (keep true)

# ---- Moderation API (/api/admin/*): disabled unless this is set to a strong key (>= 32 chars; openssl rand -hex 32) ----
ADMIN_API_KEY=

# ---- SMS (MSG91, DLT template required in India) ----
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Photos: local | s3 ----
# STORAGE_DRIVER is automatic: s3 when S3_BUCKET is set, local disk otherwise
S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000   # MinIO / Cloudflare R2
# S3_PUBLIC_ENDPOINT=                 # host phones use for presigned URLs, if different
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=  (or an IAM role)

# ---- Firebase Cloud Messaging (path to service-account JSON or the JSON itself) ----
FIREBASE_SERVICE_ACCOUNT=

# ---- Monitoring ----
SENTRY_DSN=

# ---- WebRTC TURN (needed for calls on mobile data) ----
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349"],"username":"user","credential":"pass"}]
