{
  "name": "situationship-api",
  "version": "1.0.0",
  "private": true,
  "description": "Situationship backend - NestJS + TypeScript + Prisma/PostgreSQL + Redis + Socket.IO + BullMQ",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "test:e2e": "node test/api.e2e.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^9.47.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3"
  }
}
